---
import "../css/Projects.css";
import ProjectCard from "./ProjectCard.astro";
import { getProjects } from '../data/projects'
const { t } = Astro.props
const projects = getProjects(t)
const clientProjects = projects.filter((p) => p.category === "client")
const personalProjects = projects.filter((p) => p.category === "personal")
---

<section class="projects_container" id="projects">
    <article class="projects_title">
        <h2>{t.projects_title}<small class="point"></small></h2>
        <p>
            {t.projects_subTitle}
        </p>
    </article>

    <h3 class="projects_group_title">{t.projects_client_title}</h3>
    <article class="container_boxes">
        {clientProjects.map((project) => <ProjectCard project={project} t={t} />)}
    </article>

    <div class="projects_group_header">
        <h3 class="projects_group_title">{t.projects_personal_title}</h3>
        <p>{t.projects_personal_subTitle}</p>
    </div>
    <article class="container_boxes">
        {personalProjects.map((project) => <ProjectCard project={project} t={t} />)}
    </article>

    <article class="see-more">
        <span>{t.wanna_see_more}</span>
        <a href="https://github.com/juanicenteno" target="_blank" rel="noopener noreferrer"
            >{t.see_all_projects} <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
                class="size-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"></path>
            </svg>
        </a>
    </article>
</section>
