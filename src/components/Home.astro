---
import "../css/Home.css";
import { getLang, projectPath } from "../utils/i18n";
const { t } = Astro.props;
const lang = getLang(Astro.url);
// Heroicons (outline): building, cog, sparkles — one per service, same order as t.services
const serviceIcons = [
    "M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21",
    "M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 0 1 1.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.559.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.894.149c-.424.07-.764.383-.929.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 0 1-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.398.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 0 1-.12-1.45l.527-.737c.25-.35.272-.806.108-1.204-.165-.397-.506-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.108-1.204l-.526-.738a1.125 1.125 0 0 1 .12-1.45l.773-.773a1.125 1.125 0 0 1 1.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894Z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
    "M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z",
];
---

<div id="home" class="bento_container">
    <div class="bento_grid">
        <!-- CARD 1: HERO / INTRO -->
        <div class="bento_card card_hero">
            <a href="#contact" class="status_badge">
                <span class="pulse_dot"></span>
                <span>{t.available_to_work}</span>
            </a>
            <div class="hero_content">
                <h1>{t.hello_im} <span class="wave">👋</span></h1>
                <h2 class="gradient_text">
                    {t.hello_subtitle} <span class="highlight_span">{t.hello_subtitlePartColor}</span>
                </h2>
                <p class="hero_desc">
                    {t.hello_subtitlePart2}
                </p>
                <div class="hero_actions">
                    <a href="#projects" class="action_btn btn_contact">
                        <span>{t.hero_cta_projects}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="btn_icon">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                        </svg>
                    </a>
                    <a href="./Juan_Ignacio_Centeno_CV.pdf" class="action_btn btn_cv" target="_blank">
                        <span>{t.download_cv}</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- CARD 2: ESTUDIOS / TIMELINE -->
        <div class="bento_card card_studies" id="studies">
            <div class="card_header">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="card_icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                </svg>
                <h3>{t.my_studies}</h3>
            </div>
            <div class="timeline">
                <div class="timeline_item">
                    <div class="timeline_dot active"></div>
                    <div class="timeline_content">
                        <div class="item_title">
                            <h4>{t.university}</h4>
                            <span class="timeline_date">Mar 2026</span>
                        </div>
                        <p class="timeline_org">{t.university_name}</p>
                        <p class="timeline_desc">{t.university_desc}</p>
                    </div>
                </div>
                <div class="timeline_item">
                    <div class="timeline_dot"></div>
                    <div class="timeline_content">
                        <div class="item_title">
                            <h4>{t.curse_2}</h4>
                            <span class="timeline_date">2025</span>
                        </div>
                        <p class="timeline_org">{t.university_name}</p>
                        <p class="timeline_desc">{t.curse_2_desc}</p>
                    </div>
                </div>
                <div class="timeline_item">
                    <div class="timeline_dot"></div>
                    <div class="timeline_content">
                        <div class="item_title">
                            <h4>{t.curse_1}</h4>
                            <span class="timeline_date">2022</span>
                        </div>
                        <p class="timeline_org">Digital House</p>
                        <p class="timeline_desc">{t.curse_1_desc}</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- CARD 3: SOBRE MÍ / EXP -->
        <div class="bento_card card_about">
            <div class="card_header">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="card_icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                </svg>
                <h3>{t.about_me}</h3>
            </div>
            <div class="about_content">
                <p>
                    {t.i_am} <span class="highlight_purple">{t.about_meDescColor}</span> {t.about_meDesc} <span class="highlight_purple">{t.about_meDescColor2}</span> {t.about_meDesc2}
                </p>
                <p>
                    {t.about_meDesc3}
                </p>
                <p>
                    {t.about_meDesc5} <span class="highlight_purple">{t.about_meDescColor5}</span> {t.about_meDesc6} {t.about_meDesc7} <span class="highlight_purple">2022</span> {t.about_meDesc8}
                </p>
            </div>
        </div>

        <!-- CARD 4: SERVICIOS -->
        <div class="bento_card card_services">
            <div class="card_header">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="card_icon" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
                </svg>
                <h3>{t.services_title}</h3>
            </div>
            <div class="services_grid">
                {t.services.map((service: any, i: number) => (
                    <a href={projectPath(lang, service.slug)} class="service_item">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="service_icon" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d={serviceIcons[i]} />
                        </svg>
                        <h4>{service.title}</h4>
                        <p>{service.desc}</p>
                        <span class="service_link">
                            {service.example}
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                            </svg>
                        </span>
                    </a>
                ))}
            </div>
        </div>

        <!-- CARD 5: ENLACES / CONTACTO -->
        <div class="bento_card card_links" id="contact">
            <div class="card_header">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="card_icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                </svg>
                <h3>{t.connect_title}</h3>
            </div>
            <p class="links_subtitle">{t.connect_subtitle}</p>
            <div class="links_grid">
                <a href="mailto:juanignaciocenteno5@gmail.com" class="action_btn btn_contact">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="btn_icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                    </svg>
                    <span>{t.contact_me}</span>
                </a>
                
                <a href="https://github.com/juanicenteno" class="action_btn btn_github" target="_blank">
                    <svg height="20" viewBox="0 0 24 24" width="20" fill="currentColor" class="btn_icon">
                        <path d="M12 1C5.923 1 1 5.923 1 12c0 4.867 3.149 8.979 7.521 10.436.55.096.756-.233.756-.522 0-.262-.013-1.128-.013-2.049-2.764.509-3.479-.674-3.699-1.292-.124-.317-.66-1.293-1.127-1.554-.385-.207-.936-.715-.014-.729.866-.014 1.485.797 1.691 1.128.99 1.663 2.571 1.196 3.204.907.096-.715.385-1.196.701-1.471-2.448-.275-5.005-1.224-5.005-5.432 0-1.196.426-2.186 1.128-2.956-.111-.275-.496-1.402.11-2.915 0 0 .921-.288 3.024 1.128a10.193 10.193 0 0 1 2.75-.371c.936 0 1.871.123 2.75.371 2.104-1.43 3.025-1.128 3.025-1.128.605 1.513.221 2.64.111 2.915.701.77 1.127 1.747 1.127 2.956 0 4.222-2.571 5.157-5.019 5.432.399.344.743 1.004.743 2.035 0 1.471-.014 2.654-.014 3.025 0 .289.206.632.756.522C19.851 20.979 23 16.854 23 12c0-6.077-4.922-11-11-11Z" />
                    </svg>
                    <span>GitHub</span>
                </a>

                <a href="./Juan_Ignacio_Centeno_CV.pdf" class="action_btn btn_cv" target="_blank">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="btn_icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    <span>{t.download_cv}</span>
                </a>
            </div>
        </div>
    </div>
</div>
