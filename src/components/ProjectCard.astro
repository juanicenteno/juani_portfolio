---
import { Image } from "astro:assets";
import ProjectLinks from "./ProjectLinks.astro";
import { getSlug, type ProjectEntry } from "../utils/projects";
import { projectPath, type Lang } from "../utils/i18n";

interface Props {
    project: ProjectEntry;
    lang: Lang;
    t: any;
}

const { project, lang, t } = Astro.props;
const { title, summary, image, highlight, technologies, github, website, featured } = project.data;
const detailHref = projectPath(lang, getSlug(project));
---

<div class:list={["box_project", { featured }]}>
    {highlight && <span class="project_highlight">{highlight}</span>}
    <a href={detailHref} class="browser_frame" tabindex="-1" aria-hidden="true">
        <div class="browser_bar">
            <span></span><span></span><span></span>
        </div>
        <Image
            src={image}
            alt=""
            widths={[480, 960]}
            sizes={featured ? "(min-width: 1024px) 50vw, 90vw" : "(min-width: 1024px) 40vw, 90vw"}
            loading="lazy"
        />
    </a>
    <div class="project_body">
        <div class="project_desc">
            <h3><a href={detailHref}>{title}</a></h3>
            <p>{summary}</p>
            <ul class="technologies_used">
                {technologies.map((tech) => <li>{tech}</li>)}
            </ul>
            <a href={detailHref} class="project_case_link">
                {t.view_case}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                </svg>
            </a>
        </div>
        <div class="links_project">
            <ProjectLinks github={github} website={website} t={t} />
        </div>
    </div>
</div>
