---
import "../css/Skills.css";
import SkillIcon from "./SkillIcon.astro";
const { t } = Astro.props;

const columns = [
    [
        {
            title: "Frontend",
            skills: [
                { icon: "html", name: "HTML5" },
                { icon: "css", name: "CSS3" },
                { icon: "javascript", name: "JavaScript" },
                { icon: "typescript", name: "TypeScript" },
                { icon: "tailwind", name: "Tailwind CSS" },
            ],
        },
        {
            title: "Frameworks",
            skills: [
                { icon: "nextjs", name: "Next.js" },
                { icon: "react", name: "React.js" },
                { icon: "astro", name: "Astro" },
            ],
        },
    ],
    [
        {
            title: "Backend",
            skills: [
                { icon: "nodejs", name: "Node.js" },
                { icon: "express", name: "Express" },
                { icon: "mysql", name: "MySQL" },
                { icon: "lua", name: "Lua" },
            ],
        },
        {
            title: t.skills_tools,
            skills: [
                { icon: "git", name: "Git" },
                { icon: "github", name: "GitHub" },
                { icon: "vercel", name: "Vercel" },
                { icon: "playwright", name: "Playwright" },
            ],
        },
        {
            title: t.design,
            skills: [
                { icon: "figma", name: "Figma" },
                { icon: "canva", name: "Canva" },
            ],
        },
    ],
];
---

<section class="my_skills" id="skills">
    <h2>
        {t.my_skills}<small class="point"></small>
    </h2>
    <div class="container_skills">
        {columns.map((groups, i) => (
            <div class={i === 0 ? "first_skills" : "second_skills"}>
                {groups.map((group) => (
                    <article class="frontend_skills">
                        <p>{group.title}</p>
                        <ul class="languages">
                            {group.skills.map((skill) => (
                                <li>
                                    <SkillIcon name={skill.icon} />
                                    {skill.name}
                                </li>
                            ))}
                        </ul>
                    </article>
                ))}
            </div>
        ))}
    </div>
</section>
