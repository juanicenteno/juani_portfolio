---
import "../css/Skills.css";
import SkillIcon from "./SkillIcon.astro";
const { t } = Astro.props;
---

<section class="my_skills" id="skills">
    <h2>
        {t.my_skills}<small class="point"></small>
    </h2>
    <div class="container_skills">
        <div class="first_skills">
            <article class="frontend_skills">
                <p>Frontend Core</p>
                <ul class="languages">
                    <li>
                        <SkillIcon name="html" />
                        HTML5
                    </li>
                    <li>
                        <SkillIcon name="css" />
                        CSS3
                    </li>
                    <li>
                        <SkillIcon name="javascript" />
                        JavaScript
                    </li>
                </ul>
            </article>
            <article class="frontend_skills">
                <p>Frameworks</p>
                <ul class="languages">
                    <li>
                        <SkillIcon name="nextjs" />
                        Next.js
                    </li>
                    <li>
                        <SkillIcon name="react" />
                        React.js
                    </li>
                    <li>
                        <SkillIcon name="astro" />
                        Astro
                    </li>
                </ul>
            </article>
        </div>
        <div class="second_skills">
            <article class="frontend_skills">
                <p>{t.design}</p>
                <ul class="languages">
                    <li>
                        <SkillIcon name="figma" />
                        Figma
                    </li>
                    <li>
                        <SkillIcon name="canva" />
                        Canva
                    </li>
                </ul>
            </article>
            <article class="frontend_skills">
                <p>Backend/Tools</p>
                <ul class="languages">
                    <li>
                        <SkillIcon name="nodejs" />
                        Node.js
                    </li>
                    <li>
                        <SkillIcon name="mysql" />
                        MySQL
                    </li>
                    <li>
                        <SkillIcon name="git" />
                        Git
                    </li>
                    <li>
                        <SkillIcon name="github" />
                        GitHub
                    </li>
                </ul>
            </article>
        </div>
    </div>
</section>
